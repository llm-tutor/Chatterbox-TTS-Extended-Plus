post {
  url: {{base_url}}/api/v1/tts?response_mode=url
  body: json
  auth: none
}

params:query {
  response_mode: url
}

body:json {
  {
    "text": "This example demonstrates URL response mode with complete metadata including processing time, seed used, and multiple format URLs.",
